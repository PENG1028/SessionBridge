{
  "name": "session-bridge",
  "version": "0.6.0",
  "private": true,
  "description": "Claude Code remote shell — persistent process architecture with web UI",
  "files": [
    "dist/",
    ".next/",
    "adapters/",
    "lib/",
    "src/",
    "app/",
    "public/",
    "scripts/",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.server.json",
    "next.config.ts",
    "tailwind.config.ts",
    "postcss.config.mjs"
  ],
  "bin": {
    "bridge": "./dist/index.js"
  },
  "scripts": {
    "start": "next build && npm run build:server && node dist/index.js",
    "start:quick": "npm run build:server && node dist/index.js",
    "start:leaf": "node dist/index.js --role leaf",
    "dev": "next build && tsx watch src/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
