[Unit]
Description=SessionBridge Remote Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/session-bridge/node dist/agent.js \
  --relay ws://YOUR_VPS_IP:8080 \
  --dir /home/user/project \
  --label my-pc \
  --log-file /var/log/session-bridge/agent.log \
  --pid-file /var/run/session-bridge/agent.pid
WorkingDirectory=/opt/session-bridge
Restart=always
RestartSec=5
StandardOutput=append:/var/log/session-bridge/agent.log
StandardError=append:/var/log/session-bridge/agent.log

# Security hardening
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
