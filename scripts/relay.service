[Unit]
Description=SessionBridge Go Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=node /opt/session-bridge/bin/bridge.js core
WorkingDirectory=/opt/session-bridge
Restart=always
RestartSec=5
User=sessionbridge

# Go Core env vars
Environment=LISTEN_ADDR=0.0.0.0:8080
Environment=SESSIONNODE_DATA_DIR=/var/lib/sessionbridge
Environment=SESSIONNODE_PLUGIN_DIRS=/opt/session-bridge/plugins

# Logging
StandardOutput=append:/var/log/session-bridge/core.log
StandardError=append:/var/log/session-bridge/core.log

# Security hardening
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
