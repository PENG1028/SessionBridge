{
  "id": "shell",
  "displayName": "Shell Terminal",
  "version": "0.6.0",
  "extensionKind": ["adapter", "visual", "configuration-only"],
  "icon": "terminal",
  "viewId": "terminal",
  "engines": { "sessionbridge": "^0.6.0" },
  "main": "./index.js",
  "activationEvents": ["onStartupFinished"],
  "runtime": {
    "installHint": "Built-in — no installation required"
  },
  "capabilities": {
    "terminal": true,
    "fileContext": false,
    "structuredEvents": false,
    "approvals": false,
    "modes": false,
    "timeline": false,
    "compact": false,
    "tasks": false
  },
  "contributes": {
    "views": {
      "sidebar-left": [
        { "id": "files", "title": "Files", "icon": "folder", "order": 10, "defaultVisible": true, "when": "view == \"terminal\"" }
      ],
      "sidebar-right": [
        { "id": "processes", "title": "Processes", "icon": "activity", "defaultVisible": true, "when": "view == \"terminal\"" }
      ]
    },
    "commands": [
      { "id": "shell.clear", "title": "Clear Terminal", "category": "Terminal", "icon": "x", "when": "activeAdapterId == shell" },
      { "id": "shell.kill", "title": "Kill Process", "category": "Terminal", "icon": "stop-circle", "when": "isRunning" }
    ],
    "menus": [
      { "id": "shell.menu.clear", "menu": "terminal/context", "title": "Clear", "command": "shell.clear", "group": "edit", "when": "view == \"terminal\"" },
      { "id": "shell.menu.kill", "menu": "terminal/context", "title": "Kill Instance", "command": "shell.kill", "group": "navigation", "when": "view == \"terminal\" && isRunning" }
    ],
    "chrome": {
      "statusBar": [
        { "id": "shell.status.mode", "text": "TERMINAL", "side": "left", "order": 10, "when": "view == \"terminal\"" }
      ],
      "contextControls": [
        {
          "id": "shell.hint.stop",
          "kind": "hint",
          "label": "Stop",
          "keys": "Esc",
          "placement": "bottom-right",
          "priority": 90,
          "when": "view == \"terminal\" && isRunning",
          "command": "shell.kill"
        },
        {
          "id": "shell.hint.clear",
          "kind": "hint",
          "label": "Clear",
          "keys": "⌘L",
          "placement": "bottom-right",
          "priority": 50,
          "when": "view == \"terminal\"",
          "command": "shell.clear"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "shell.defaultShell": {
          "type": "string",
          "default": "bash",
          "description": "Default shell command (bash, zsh, fish, powershell, etc.)",
          "scope": "workspace"
        }
      }
    },
    "spawn": {
      "command": "bash",
      "args": ["--login"]
    }
  }
}
