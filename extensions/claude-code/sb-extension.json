{
  "id": "claude-code",
  "displayName": "Claude Code",
  "version": "0.6.0",
  "extensionKind": ["adapter", "visual", "configuration-only"],
  "icon": "sparkles",
  "viewId": "claude-chat",
  "engines": { "sessionbridge": "^0.6.0" },
  "main": "./index.js",
  "activationEvents": ["onStartupFinished"],
  "runtime": {
    "detectCommand": "claude --version",
    "installHint": "npm install -g @anthropic-ai/claude-code"
  },
  "capabilities": {
    "terminal": true,
    "fileContext": true,
    "structuredEvents": true,
    "approvals": true,
    "modes": true,
    "timeline": true,
    "compact": true,
    "tasks": true
  },
  "contributes": {
    "views": {
      "sidebar-left": [
        { "id": "quick-actions", "title": "Quick Actions", "icon": "zap", "order": 20, "defaultVisible": true, "when": "view == \"claude-chat\"" }
      ],
      "sidebar-right": [
        { "id": "tasks", "title": "Tasks", "icon": "list-checks", "order": 10, "defaultVisible": true, "when": "view == \"claude-chat\"" },
        { "id": "session-actions", "title": "Actions", "icon": "play", "order": 20, "defaultVisible": true, "when": "view == \"claude-chat\"" },
        { "id": "snapshots", "title": "Snapshots", "icon": "camera", "order": 30, "defaultVisible": true, "when": "view == \"claude-chat\"" },
        { "id": "files-context", "title": "Files in Context", "icon": "file-text", "order": 40, "defaultVisible": true, "when": "view == \"claude-chat\"" },
        { "id": "terminal-log", "title": "Terminal Log", "icon": "terminal", "order": 50, "defaultVisible": true, "when": "view == \"claude-chat\"" },
        { "id": "logs", "title": "Logs", "icon": "scroll-text", "order": 100, "defaultVisible": false, "when": "view == \"claude-chat\"" },
        { "id": "terminal", "title": "Terminal", "icon": "terminal", "order": 100, "defaultVisible": false, "when": "view == \"claude-chat\"" }
      ]
    },
    "notifications": [
      { "id": "claude.session.ended", "label": "Session Ended", "description": "Notify when a Claude session completes" },
      { "id": "claude.error", "label": "Runtime Error", "description": "Notify when Claude encounters an error" },
      { "id": "claude.tool.approval", "label": "Tool Approval", "description": "Notify when tool use requires approval" }
    ],
    "commands": [
      { "id": "claude.cost", "title": "Show Cost", "category": "Session", "icon": "dollar-sign" },
      { "id": "claude.compact", "title": "Compact Conversation", "category": "Session", "icon": "compress", "when": "isRunning" },
      { "id": "claude.status", "title": "Session Status", "category": "Session", "icon": "info" },
      { "id": "claude.clearHistory", "title": "Clear History", "category": "Session", "when": "view == \"claude-chat\"" },
      { "id": "claude.restart", "title": "Restart Session", "category": "Session", "when": "view == \"claude-chat\"" }
    ],
    "menus": [
      { "id": "claude.menu.rewind", "menu": "chat/context", "title": "Rewind Last Change", "command": "rewind", "group": "navigation", "when": "view == \"claude-chat\"" },
      { "id": "claude.menu.compact", "menu": "chat/context", "title": "Compact Session", "command": "claude.compact", "group": "edit", "when": "view == \"claude-chat\" && isRunning" },
      { "id": "claude.menu.clearHistory", "menu": "chat/context", "title": "Clear History", "command": "claude.clearHistory", "group": "edit", "when": "view == \"claude-chat\"" },
      { "id": "claude.menu.copyAll", "menu": "chat/context", "title": "Copy All", "command": "claude.copyAll", "group": "edit", "when": "view == \"claude-chat\"" },
      { "id": "claude.menu.restart", "menu": "chat/context", "title": "Restart Session", "command": "claude.restart", "group": "navigation", "when": "view == \"claude-chat\"" }
    ],
    "chrome": {
      "statusBar": [
        { "id": "claude.status.mode", "text": "Claude", "side": "left", "order": 10, "when": "view == \"claude-chat\"" }
      ],
      "contextControls": [
        {
          "id": "claude.hint.commands",
          "kind": "hint",
          "label": "Commands",
          "keys": "⌘⇧P",
          "placement": "bottom-right",
          "priority": 50,
          "when": "view == \"claude-chat\"",
          "command": "host.commandPalette.open"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "claude-code.maxThinkingTokens": {
          "type": "integer",
          "default": 32000,
          "description": "Maximum thinking tokens for Claude",
          "scope": "workspace",
          "requiresRestart": true,
          "minimum": 0
        },
        "claude-code.defaultPermissionMode": {
          "type": "string",
          "default": "default",
          "enum": ["default", "acceptEdits", "plan"],
          "description": "Default permission mode",
          "scope": "workspace"
        }
      }
    },
    "spawn": {
      "command": "claude",
      "args": ["-p", "--output-format", "stream-json"]
    }
  }
}
